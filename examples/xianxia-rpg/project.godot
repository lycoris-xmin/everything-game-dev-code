; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="仙侠回合制RPG"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.7", "C#")
config/icon="res://icon.svg"

[autoload]

SaveService="*res://scripts/Autoloads/SaveService.cs"
ProgressionState="*res://scripts/Autoloads/ProgressionState.cs"
ConfigLoader="*res://scripts/Autoloads/ConfigLoader.cs"
InputManager="*res://scripts/Autoloads/InputManager.cs"
EventBus="*res://scripts/Autoloads/EventBus.cs"
Telemetry="*res://scripts/Autoloads/Telemetry.cs"
PlatformService="*res://scripts/Autoloads/PlatformService.cs"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="viewport"

[dotnet]

project/assembly_name="XianxiaRPG"

[input]

battle_select={
"deadzone": 0.5,
"events": []
}
world_interact={
"deadzone": 0.5,
"events": []
}
menu_confirm={
"deadzone": 0.5,
"events": []
}
